# ENTSO-E Transparency Platform API Key
# Register at: https://transparency.entsoe.eu/
# Required for fetching European energy market data
ENTSOE_API_KEY=your_32_character_api_key_here

# Server Configuration (Optional)
PORT=3000
NODE_ENV=development

# AI Configuration
# Enable/disable AI-powered insights using Ollama
AI_INSIGHTS_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3:8b
AI_INSIGHTS_CACHE_TTL=300000

# Web Tools Configuration
# Enable online information access (weather, news, web search)
WEB_TOOLS_ENABLED=true

# Optional: NewsAPI key for enhanced news search
# Register at: https://newsapi.org/ (free tier available)
# If not provided, will fallback to RSS feeds
NEWS_API_KEY=your_news_api_key_here

# SSL Configuration (Development only - remove in production)
# Set to 0 to bypass SSL certificate validation
NODE_TLS_REJECT_UNAUTHORIZED=0
